{
  "name": "ahl-athar",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test server/index.test.js server/media-library.test.js server/lecture-api.test.js server/suggestions/suggestion.test.js server/ai/ai.test.js server/ai/approval-api.test.js",
    "build:adhan": "node scripts/copy-adhan.mjs",
