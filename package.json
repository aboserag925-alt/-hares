    "build:css": "tailwindcss -i ./src/tailwind.css -o ./app/tailwind.css",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o ./app/tailwind.css --watch"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "adhan": "^4.4.6"
  }
}
