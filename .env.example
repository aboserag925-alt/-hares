# Public Turnstile site key used by the browser and Supabase Auth (optional).
TURNSTILE_SITE_KEY=

# Enable question-endpoint Turnstile on production with the server-only secret.
# Local development remains unchallenged when both values are unset/false.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Set true only when the origin is reachable exclusively through Cloudflare's trusted proxy.
TRUST_PROXY=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=
TELEGRAM_MEDIA_ENABLED=false
TELEGRAM_MEDIA_GROUP_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# أصول CORS المسموحة مفصولة بفواصل، مثال: https://example.com,https://example.github.io
ALLOWED_ORIGINS=
# عنوان ومنفذ الخادم (Docker يضبطهما افتراضيًا داخل الحاوية)
HOST=127.0.0.1
PORT=8080
# منفذ المضيف عند التشغيل عبر Docker Compose
HOST_PORT=8080
